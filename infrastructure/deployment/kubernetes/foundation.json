        }
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "api",
          "app.kubernetes.io/part-of": "company-brain"
        },
        "ports": [
          {
            "name": "http",
            "port": 8000,
            "targetPort": "http"
          }
        ]
      }
    },
