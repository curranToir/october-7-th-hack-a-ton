            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "orchestrator",
                "image": "__ORCHESTRATOR_IMAGE__",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8000
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "384Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": "http"
                  },
                  "periodSeconds": 2,
                  "failureThreshold": 60
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": "http"
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 2
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ],
                "env": [
                  {
                    "name": "TOIR_DATA_DIR",
                    "value": "/data"
                  },
                  {
                    "name": "RESEARCH_AGENT_URL",
                    "value": "http://research:8000"
                  },
                  {
                    "name": "RESPAN_MODEL",
                    "value": "gpt-5.4"
                  },
                  {
                    "name": "RESPAN_BASE_URL",
                    "value": "https://api.respan.ai/api/"
                  }
                ],
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "orchestrator-runtime"
                    }
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "64Mi"
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "coordinator-data"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "orchestrator",
        "namespace": "company-brain",
        "labels": {
          "app.kubernetes.io/name": "orchestrator",
