              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "api",
                "image": "__API_IMAGE__",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8000
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": "http"
                  },
                  "periodSeconds": 2,
                  "failureThreshold": 60
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": "http"
                  },
                  "periodSeconds": 15,
                  "timeoutSeconds": 2
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/api/ready",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "env": [
                  {
                    "name": "ORCHESTRATOR_URL",
                    "value": "http://orchestrator:8000"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "64Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "api",
        "namespace": "company-brain",
        "labels": {
          "app.kubernetes.io/name": "api",
