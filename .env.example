# Deployment scripts read exported environment variables, not this file.
AWS_ACCOUNT_ID=904469541651
AWS_REGION=us-east-1
STACK_NAME=company-brain-hackathon

# Non-secret local development settings (Kubernetes supplies its own values).
ORCHESTRATOR_URL=http://127.0.0.1:8001
RESEARCH_AGENT_URL=http://127.0.0.1:8002
CONTACT_AGENT_URL=http://127.0.0.1:8003
MEETING_AGENT_URL=http://127.0.0.1:8004
MEETING_OWNER_EMAIL=curran@toirinc.com
MEETING_GITHUB_REPOSITORY=curranToir/october-7-th-hack-a-ton
# Explicit existing Scalekit GitHub account. Must be ACTIVE before task approval.
# A configured MEETING_GITHUB_TOKEN takes precedence for direct-token compatibility.
MEETING_GITHUB_CONNECTION_NAME=github-connect
MEETING_GITHUB_ACCOUNT_ID=curran@toirinc.com
RECALL_REGION=us-west-2
# Set to an internet-reachable HTTPS origin for Recall webhooks; blank disables live joins.
# Keep the regular app sign-in configured separately with SALES_PUBLIC_URL.
MEETING_WEBHOOK_BASE_URL=
TOIR_DATA_DIR=.deployment/data
RESPAN_BASE_URL=https://api.respan.ai/api/
RESPAN_MODEL=gpt-5-mini
# Google sign-in uses the existing Scalekit Google social connection and credentials.
# See coms/auth-handoff.md for user/session records and provider setup.
# Register this exact callback with Scalekit: http://localhost:8080/api/auth/callback
# HTTP is permitted only for loopback browser origins; remote origins require HTTPS.
SALES_PUBLIC_URL=http://localhost:8080
SALES_MEMBER_EMAILS=curran@toirinc.com,jared@neptuneops.com
# Background dispatch starts disabled in persisted automation settings.
SCALEKIT_HUBSPOT_CONNECTION=hubspot
SCALEKIT_HUBSPOT_IDENTIFIER=curran@toirinc.com
# Operator attestation after checking granted HubSpot scopes; never bypasses proposal approval.
SCALEKIT_HUBSPOT_WRITE_SCOPES_VERIFIED=false

# Runtime credentials live in AWS Secrets Manager; no values belong in this file.
# Use: .venv/bin/python infrastructure/deployment/scripts/manage.py secret-set --name respan
# Stack-owned groups: respan, scalekit, exa. Exa's direct key is never supplied to pods.
# Optional stack-owned group: meetings-provider (coordinator only).
# Use hidden prompts: manage.py secret-set --name meetings-provider
# Keys: RECALL_API_KEY, RECALL_WORKSPACE_VERIFICATION_SECRET (whsec_),
# MEETING_GITHUB_TOKEN (fine-grained repository Issues write), optional RECALL_REGION,
# MEETING_WEBHOOK_BASE_URL and legacy RECALL_SVIX_WEBHOOK_SECRET.
# The meetings worker receives only RESPAN_API_KEY; no provider/database credentials.
# See docs/meeting-agent.md for live setup, webhook subscriptions and demo flow.
# Existing Spark-owned groups (referenced by exact ARN, never recreated by CF):
# /company-brain-hackathon/database: DATABASE_URL (coordinator only)
# /company-brain-hackathon/brain-api: BRAIN_API_URL, BRAIN_API_TOKEN (coordinator only)
# DATABASE_URL is optional locally; absent means SQLite, never production-ready automation.
# Remote Postgres requires sslmode=verify-full and a trusted sslrootcert bundle.
# TEST_DATABASE_URL must target only toir_runs_test; tests create isolated schemas.
