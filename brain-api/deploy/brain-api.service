[Unit]
Description=Toir Company Brain API
Wants=network-online.target
After=network-online.target tailscaled.service docker.service

[Service]
User=jlyon
Group=hackathon
WorkingDirectory=/srv/october-7-th-hack-a-ton/brain-api
ExecStart=/srv/october-7-th-hack-a-ton/brain-api/.venv/bin/python -m brain serve
Restart=on-failure
UMask=0007

[Install]
WantedBy=multi-user.target
